# AI Service Port/Host (Handled automatically on Vercel)
PORT=8000
HOST=0.0.0.0

# AI Provider - Switch to openai or stable-diff for production if Ollama isn't available
# On Vercel, Ollama is usually not accessible. Set AI_PROVIDER=openai and configure OPENAI_API_KEY
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_TEXT_MODEL=llama3

# Required for Vercel / Production deployment if using OpenAI
# OPENAI_API_KEY=your-api-key-here
# STABILITY_API_KEY=
