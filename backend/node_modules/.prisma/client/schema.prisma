// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  analyses Analysis[]

  @@map("projects")
}

model Analysis {
  id                String         @id @default(cuid())
  projectId         String
  type              AnalysisType   @default(SCREENSHOT)
  sourceUrl         String?
  originalImagePath String?
  status            AnalysisStatus @default(PENDING)
  summary           String?
  rawAiResponse     Json?
  userInstruction   String?
  isDemo            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  redesigns Redesign[]

  @@map("analyses")
}

model Issue {
  id             String        @id @default(cuid())
  analysisId     String
  category       IssueCategory
  title          String
  description    String
  whyItMatters   String
  recommendation String
  severity       Severity
  source         IssueSource   @default(AI)
  createdAt      DateTime      @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("issues")
}

model Redesign {
  id              String         @id @default(cuid())
  analysisId      String
  imageUrl        String?
  promptUsed      String?
  userInstruction String?
  status          RedesignStatus @default(PENDING)
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  analysis       Analysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  generatedCodes GeneratedCode[]

  @@map("redesigns")
}

model GeneratedCode {
  id           String   @id @default(cuid())
  redesignId   String
  jsxCode      String?
  cssCode      String?
  tailwindCode String?
  createdAt    DateTime @default(now())

  redesign Redesign @relation(fields: [redesignId], references: [id], onDelete: Cascade)

  @@map("generated_codes")
}

enum AnalysisType {
  SCREENSHOT
  URL
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum IssueCategory {
  LAYOUT
  TYPOGRAPHY
  COLOR
  SPACING
  HIERARCHY
  ACCESSIBILITY
  NAVIGATION
  CONTENT
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum IssueSource {
  AI
  AXE_CORE
  AUTOMATED
}

enum RedesignStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  UNAVAILABLE
}
