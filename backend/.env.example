PORT=3001
NODE_ENV=development

# When deploying to Vercel, FRONTEND_URL is optional as Vercel rewrites handles CORS natively
FRONTEND_URL=http://localhost:5173

# AI Service URL - In local dev this is localhost:8000
# On Vercel, this is automatically injected via the Service Binding configured in vercel.json!
AI_SERVICE_URL=http://localhost:8000

# Prisma Database - Leave as is for in-memory SQLite fallback, or provide a real postgres URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uiux_analyzer?schema=public"
